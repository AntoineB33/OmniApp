    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
        ,
        {
            "name": "tests_displayer debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/side-dev/tests_displayer.py",
            "console": "integratedTerminal"
        }
    ]
}