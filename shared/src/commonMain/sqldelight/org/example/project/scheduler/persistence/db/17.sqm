-- Schema v17 -> v18: a banked screen break the user put where it stands.
--
-- Added 2026-10-07 for docs/scheduler_requirements.md § frozen past, its first exception (the user rewrites history):
-- a screen break dragged on the calendar is banked where the hand put it, and the calendar outlines it in blue.
-- 0 on every row an older build wrote: the line banked those. LOCAL-ONLY, never synced.

ALTER TABLE screen_break_history ADD COLUMN by_hand INTEGER NOT NULL DEFAULT 0;
